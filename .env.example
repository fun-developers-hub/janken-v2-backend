# サーバーがリッスンするポート番号
PORT=8080

# CORSで許可するオリジン（カンマ区切りで複数指定可能）
# 例: http://localhost:3000,https://example.com
# 未設定の場合はすべてのオリジンを許可（*）
ALLOW_ORIGINS=http://localhost:3000

# --- データベース (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=password
DB_NAME=janken

# --- MySQL コンテナ用 (docker compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=janken
MYSQL_USER=app
MYSQL_PASSWORD=password

